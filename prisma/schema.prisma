=datasource db {
=  provider = "postgresql"
=  url      = env("DATABASE_URL")
=}
=
=generator client {
=  provider = "prisma-client-js"
=}
=
=enum Role {
=  CLIENT
=  ADMIN
=  AGENT
=}
=
=enum BookingType {
=  CIRCUIT
=  FLIGHT
=  EVENT
=}
=
=enum BookingStatus {
=  PENDING
=  CONFIRMED
=  CANCELLED
=  COMPLETED
=}
=
=enum PaymentStatus {
=  PENDING
=  PARTIAL
=  PAID
=  FAILED
=  REFUNDED
=}
=
=enum PaymentMethod {
=  MOBILE_MONEY_MTN
=  MOBILE_MONEY_MOOV
=  FEDAPAY
=  STRIPE_CARD
=  BANK_TRANSFER
=  CASH
=}
=
=enum VisaStatus {
=  SUBMITTED
=  PROCESSING
=  APPROVED
=  REJECTED
=}
=
=enum EventStatus {
=  DRAFT
=  REQUESTED
=  QUOTED
=  CONFIRMED
=  IN_PROGRESS
=  COMPLETED
=  CANCELLED
=}
=
=enum TripType {
=  INDIVIDUAL
=  GROUP
=}
=
=enum TripStatus {
=  UPCOMING
=  ONGOING
=  COMPLETED
=  CANCELLED
=}
=
=enum MediaType {
=  PHOTO
=  VIDEO
=}
=
=enum ScheduleStatus {
=  PENDING
=  PAID
=  LATE
=}
=
=model User {
=  id            String          @id @default(uuid())
=  email         String          @unique
=  phone         String?
=  name          String
=  passwordHash  String?
=  role          Role            @default(CLIENT)
=  loyaltyPoints Int             @default(0)
=  createdAt     DateTime        @default(now())
=  updatedAt     DateTime        @updatedAt
=
=  flightBookings FlightBooking[]
=  visaRequests   VisaRequest[]
=  events         Event[]
=  bookings       Booking[]
=  testimonials   Testimonial[]
=  tripParticipants TripParticipant[]
=  tripUpdates    TripUpdate[]    @relation("UserTripUpdates")
=  tripMedia      TripMedia[]
=  tripFeedbacks  TripFeedback[]
=
=  @@map("users")
=}
=
=model Destination {
=  id              String      @id @default(uuid())
=  slug            String      @unique
=  name            String
=  country         String
=  region          String?
=  description     String
=  highlights      String[]
=  images          String[]
=  climate         String
=  bestPeriod      String
=  isInternational Boolean     @default(false)
=  isFeatured      Boolean     @default(false)
=  latitude        Float?
=  longitude       Float?
=  createdAt       DateTime    @default(now())
=  updatedAt       DateTime    @updatedAt
=
=  circuits        Circuit[]
=  testimonials    Testimonial[]
=
=  @@map("destinations")
=}
=
=model Circuit {
=  id            String      @id @default(uuid())
=  slug          String      @unique
=  title         String
=  destinationId String
=  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
=  durationDays  Int
=  priceXOF      Int
=  priceEUR      Float?
=  itinerary     Json
=  included      String[]
=  excluded      String[]
=  images        String[]
=  theme         String      // e.g. "Culture", "Safari", "Plage", "Aventure"
=  isFeatured    Boolean     @default(false)
=  createdAt     DateTime    @default(now())
=  updatedAt     DateTime    @updatedAt
=
=  @@map("circuits")
=}
=
=model FlightBooking {
=  id          String        @id @default(uuid())
=  userId      String
=  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
=  origin      String
=  destination String
=  departDate  DateTime
=  returnDate  DateTime?
=  passengers  Int           @default(1)
=  flightClass String        @default("ECONOMY")
=  status      BookingStatus @default(PENDING)
=  priceXOF    Int
=  pnrCode     String?
=  createdAt   DateTime      @default(now())
=  updatedAt   DateTime      @updatedAt
=
=  @@map("flight_bookings")
=}
=
=model VisaRequest {
=  id          String     @id @default(uuid())
=  userId      String
=  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
=  country     String
=  documents   String[]
=  status      VisaStatus @default(SUBMITTED)
=  adminNotes  String?
=  feeXOF      Int
=  submittedAt DateTime   @default(now())
=  updatedAt   DateTime   @updatedAt
=
=  @@map("visa_requests")
=}
=
=model Event {
=  id         String      @id @default(uuid())
=  userId     String
=  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
=  type       String      // e.g. "Mariage", "Séminaire", "Team Building", "Anniversaire"
=  guestCount Int
=  budgetXOF  Int
=  services   String[]
=  eventDate  DateTime
=  location   String?
=  status     EventStatus @default(REQUESTED)
=  quoteFile  String?
=  createdAt  DateTime    @default(now())
=  updatedAt  DateTime    @updatedAt
=
=  @@map("events")
=}
=
=model Booking {
=  id            String        @id @default(uuid())
=  bookingNumber String        @unique @default(uuid())
=  userId        String
=  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
=  type          BookingType
=  referenceId   String        // ID of Circuit, Flight, or Event
=  totalPriceXOF Int
=  status        BookingStatus @default(PENDING)
=  paymentStatus PaymentStatus @default(PENDING)
=  createdAt     DateTime      @default(now())
=  updatedAt     DateTime      @updatedAt
=
=  payments         Payment[]
=  trips            Trip[]
=  paymentSchedules PaymentSchedule[]
=
=  @@map("bookings")
=}
=
=model Payment {
=  id             String        @id @default(uuid())
=  bookingId      String
=  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
=  amountXOF      Int
=  method         PaymentMethod
=  status         PaymentStatus @default(PENDING)
=  transactionRef String?
=  paidAt         DateTime?
=  createdAt      DateTime      @default(now())
=
=  @@map("payments")
=}
=
=model Testimonial {
=  id            String       @id @default(uuid())
=  userId        String
=  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
=  destinationId String?
=  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
=  content       String
=  rating        Int          @default(5)
=  isApproved    Boolean      @default(true)
=  createdAt     DateTime     @default(now())
=
=  @@map("testimonials")
=}
=
=model BlogPost {
=  id          String   @id @default(uuid())
=  slug        String   @unique
=  title       String
=  content     String
=  coverImage  String
=  authorName  String   @default("Équipe Nomad Tours")
=  publishedAt DateTime @default(now())
=  createdAt   DateTime @default(now())
=  updatedAt   DateTime @updatedAt
=
=  @@map("blog_posts")
=}
=
=model Trip {
=  id        String     @id @default(uuid())
=  bookingId String
=  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
=  type      TripType   @default(INDIVIDUAL)
=  startDate DateTime
=  endDate   DateTime
=  guideId   String?
=  status    TripStatus @default(UPCOMING)
=  createdAt DateTime   @default(now())
=  updatedAt DateTime   @updatedAt
=
=  participants TripParticipant[]
=  updates      TripUpdate[]
=  media        TripMedia[]
=  feedbacks    TripFeedback[]
=
=  @@map("trips")
=}
=
=model TripParticipant {
=  id              String   @id @default(uuid())
=  tripId          String
=  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
=  userId          String
=  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
=  emergencyContact String?
=  checklistStatus Json?    // JSON storing pre-trip checklist items and completion states
=  createdAt       DateTime @default(now())
=
=  @@map("trip_participants")
=}
=
=model TripUpdate {
=  id        String   @id @default(uuid())
=  tripId    String
=  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
=  authorId  String
=  author    User     @relation("UserTripUpdates", fields: [authorId], references: [id], onDelete: Cascade)
=  message   String
=  mediaUrls String[]
=  createdAt DateTime @default(now())
=
=  @@map("trip_updates")
=}
=
=model TripMedia {
=  id        String    @id @default(uuid())
=  tripId    String
=  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
=  userId    String
=  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
=  url       String
=  type      MediaType @default(PHOTO)
=  createdAt DateTime  @default(now())
=
=  @@map("trip_media")
=}
=
=model TripFeedback {
=  id          String   @id @default(uuid())
=  tripId      String
=  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
=  userId      String
=  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
=  rating      Int      @default(5)
=  comment     String
=  submittedAt DateTime @default(now())
=
=  @@map("trip_feedbacks")
=}
=
=model PaymentSchedule {
=  id        String         @id @default(uuid())
=  bookingId String
=  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
=  dueDate   DateTime
=  amountXOF Int
=  status    ScheduleStatus @default(PENDING)
=  paidAt    DateTime?
=  createdAt DateTime       @default(now())
=
=  @@map("payment_schedules")
=}
