# Supabase project API URL (public — safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (public — safe to expose to the browser,
# access is enforced by Row Level Security, not by keeping this secret).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (SECRET — server-only, bypasses RLS entirely).
# Get it from: Supabase Dashboard > Project Settings > API > service_role.
# Only used by src/lib/supabase/admin.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
